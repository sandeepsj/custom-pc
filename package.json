{
  "name": "custom-pc",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Data-first custom PC builder: parts as JSON, a thin API, and a visual frontend.",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "validate": "tsx scripts/validate.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "build:pages": "VITE_STATIC=1 vite build --base=./ && tsx scripts/export-static.ts",
    "start": "NODE_ENV=production tsx server/index.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.9",
    "hono": "^4.13.19",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
